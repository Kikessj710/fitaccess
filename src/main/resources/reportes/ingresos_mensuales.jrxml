<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ingresos_mensuales" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
    <parameter name="MES" class="java.lang.Integer"/>
    <parameter name="ANIO" class="java.lang.Integer"/>
    <queryString>
        <![CDATA[SELECT p.id,
       DATE_FORMAT(p.fecha, '%d/%m/%Y') AS fecha,
       CONCAT(c.nombres, ' ', c.apellidos) AS cliente,
       pl.nombre AS plan,
       p.monto_base,
       p.porcentaje_descuento,
       p.monto_final,
       p.metodo
FROM pago p
JOIN cliente c ON c.id = p.cliente_id
JOIN suscripcion s ON s.id = p.suscripcion_id
JOIN plan pl ON pl.id = s.plan_id
WHERE MONTH(p.fecha) = $P{MES} AND YEAR(p.fecha) = $P{ANIO}
ORDER BY p.fecha]]>
    </queryString>
    <field name="id" class="java.lang.Integer"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="plan" class="java.lang.String"/>
    <field name="monto_base" class="java.math.BigDecimal"/>
    <field name="porcentaje_descuento" class="java.math.BigDecimal"/>
    <field name="monto_final" class="java.math.BigDecimal"/>
    <field name="metodo" class="java.lang.String"/>
    <variable name="TOTAL_BASE" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{monto_base}]]></variableExpression>
    </variable>
    <variable name="TOTAL_FINAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{monto_final}]]></variableExpression>
    </variable>
    <title>
        <band height="70">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="56" backcolor="#111318"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="14" y="6" width="300" height="26" forecolor="#FF7A1A"/>
                <textElement><font size="18" isBold="true"/></textElement>
                <text><![CDATA[FITACCESS]]></text>
            </staticText>
            <staticText>
                <reportElement x="14" y="30" width="300" height="20" forecolor="#FFFFFF"/>
                <textElement><font size="11"/></textElement>
                <text><![CDATA[Ingresos del mes con descuentos por constancia]]></text>
            </staticText>
            <textField>
                <reportElement x="320" y="18" width="200" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Mes " + String.format("%02d", $P{MES}) + " / " + $P{ANIO}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="22" backcolor="#EEEEEE"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="4" y="3" width="30" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[N.]]></text></staticText>
            <staticText><reportElement x="34" y="3" width="66" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement x="100" y="3" width="150" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Cliente]]></text></staticText>
            <staticText><reportElement x="250" y="3" width="70" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Plan]]></text></staticText>
            <staticText><reportElement x="320" y="3" width="55" height="16"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[Base]]></text></staticText>
            <staticText><reportElement x="375" y="3" width="45" height="16"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[Desc.]]></text></staticText>
            <staticText><reportElement x="420" y="3" width="55" height="16"/><textElement textAlignment="Right"><font isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
            <staticText><reportElement x="480" y="3" width="55" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Metodo]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField><reportElement x="4" y="2" width="30" height="16"/><textFieldExpression><![CDATA[$F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="34" y="2" width="66" height="16"/><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>
            <textField><reportElement x="100" y="2" width="150" height="16"/><textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression></textField>
            <textField><reportElement x="250" y="2" width="70" height="16"/><textFieldExpression><![CDATA[$F{plan}]]></textFieldExpression></textField>
            <textField pattern="$ #,##0.00"><reportElement x="320" y="2" width="55" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{monto_base}]]></textFieldExpression></textField>
            <textField><reportElement x="375" y="2" width="45" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{porcentaje_descuento}.intValue() + "%"]]></textFieldExpression></textField>
            <textField pattern="$ #,##0.00"><reportElement x="420" y="2" width="55" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{monto_final}]]></textFieldExpression></textField>
            <textField><reportElement x="480" y="2" width="55" height="16"/><textFieldExpression><![CDATA[$F{metodo}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="19" width="535" height="1" forecolor="#DDDDDD"/></line>
        </band>
    </detail>
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="2" width="535" height="16" forecolor="#888888"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Pagina " + $V{PAGE_NUMBER} + "  -  Generado " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    <summary>
        <band height="70">
            <textField>
                <reportElement x="300" y="10" width="235" height="18"/>
                <textElement textAlignment="Right"><font size="11"/></textElement>
                <textFieldExpression><![CDATA["Total sin descuento: $ " + String.format("%.2f", $V{TOTAL_BASE} == null ? 0.0 : $V{TOTAL_BASE}.doubleValue())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="28" width="235" height="18"/>
                <textElement textAlignment="Right"><font size="11"/></textElement>
                <textFieldExpression><![CDATA["Descuentos por constancia: -$ " + String.format("%.2f", $V{TOTAL_BASE} == null ? 0.0 : $V{TOTAL_BASE}.subtract($V{TOTAL_FINAL}).doubleValue())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="46" width="235" height="20" forecolor="#FF7A1A"/>
                <textElement textAlignment="Right"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["INGRESOS: $ " + String.format("%.2f", $V{TOTAL_FINAL} == null ? 0.0 : $V{TOTAL_FINAL}.doubleValue())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="10" width="290" height="18"/>
                <textFieldExpression><![CDATA["Pagos registrados: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="10" width="535" height="20"/>
                <textElement textAlignment="Center"><font size="12"/></textElement>
                <text><![CDATA[No hay pagos registrados en ese mes]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
