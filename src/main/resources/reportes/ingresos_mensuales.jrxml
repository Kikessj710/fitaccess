					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{DIRECCION_GIMNASIO}]]></textFieldExpression>
			</textField>
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
