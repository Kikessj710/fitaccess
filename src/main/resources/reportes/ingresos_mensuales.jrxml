<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ingresos_mensuales" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" uuid="be61dd08-727a-4080-a32d-8538f02c4be7">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="MES" class="java.lang.Integer"/>
	<parameter name="ANIO" class="java.lang.Integer"/>
	<parameter name="NOMBRE_GIMNASIO" class="java.lang.String"/>
	<parameter name="DIRECCION_GIMNASIO" class="java.lang.String"/>
	<parameter name="TELEFONO_GIMNASIO" class="java.lang.String"/>
	<parameter name="CORREO_GIMNASIO" class="java.lang.String"/>
	<parameter name="LOGO_GIMNASIO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT p.id,
       DATE_FORMAT(p.fecha, '%d/%m/%Y') AS fecha,
       CONCAT(c.nombres, ' ', c.apellidos) AS cliente,
       pl.nombre AS plan,
       p.monto_base,
       p.porcentaje_descuento,
       p.monto_final,
       p.metodo
FROM pago p
JOIN cliente c ON c.id = p.cliente_id
JOIN suscripcion s ON s.id = p.suscripcion_id
JOIN plan pl ON pl.id = s.plan_id
WHERE MONTH(p.fecha) = $P{MES} AND YEAR(p.fecha) = $P{ANIO}
ORDER BY p.fecha]]>
	</queryString>
	<field name="id" class="java.lang.Integer"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="plan" class="java.lang.String"/>
	<field name="monto_base" class="java.math.BigDecimal"/>
	<field name="porcentaje_descuento" class="java.math.BigDecimal"/>
	<field name="monto_final" class="java.math.BigDecimal"/>
	<field name="metodo" class="java.lang.String"/>
	<variable name="TOTAL_BASE" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_base}]]></variableExpression>
	</variable>
	<variable name="TOTAL_FINAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{monto_final}]]></variableExpression>
	</variable>
